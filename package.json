{
  "name": "open-keys",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "lint": "biome ci .",
    "check": "biome check --write .",
    "typecheck": "pnpm --recursive --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "deps:check": "depcruise apps packages",
    "verify": "pnpm lint && pnpm typecheck && pnpm deps:check && pnpm test && pnpm build",
    "prepare": "lefthook install",
    "db:check": "pnpm --filter @open-keys/server db:generate && pnpm --filter @open-keys/server db:dbml && git diff --exit-code -- docs/database.dbml && test -z \"$(git status --porcelain -- apps/server/src/db/migrations)\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
